# Application Environment
# Values: development, staging, production (default: development)
APP_ENV=development

# API Configuration
APP_API__HOST=0.0.0.0
APP_API__PORT=8080
APP_API__LOG_LEVEL=info

# MQTT Configuration
APP_MQTT__BROKER=localhost
APP_MQTT__PORT=1883
APP_MQTT__CLIENT_ID=ble_to_mqtt_bridge
APP_MQTT__KEEP_ALIVE_SECS=5

# BLE Configuration
APP_BLE__ENABLE_SCAN=true
