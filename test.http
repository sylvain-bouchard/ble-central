@apiUrl = http://localhost:8080

### Start BLE scan
POST {{apiUrl}}/api/ble/scan
Content-Type: application/json

{
  "timeout_secs": 10
}


### List discovered BLE devices
GET {{apiUrl}}/api/ble/devices


### Check device availability
GET {{apiUrl}}/api/vent/status


### Connect to BLE device
### On Linux, encode the device_id (replace / with %2F)
### Example: hci0/dev_67_0C_9D_21_A7_12 → hci0%2Fdev_67_0C_9D_21_A7_12

@device_id = 5c205201-0b65-a9e2-fee7-26f4881acca1

POST {{apiUrl}}/api/ble/connect/{{device_id}}
Content-Type: application/json

{
  "timeout_secs": 10
}

### Open vent
POST {{apiUrl}}/api/vent/open

### Close vent
POST {{apiUrl}}/api/vent/close
### Disconnect from device
POST {{apiUrl}}/api/vent/disconnect

### Stop BLE scan
POST {{apiUrl}}/api/ble/stop-scan

##########################
# MQTT Operations
##########################

### Get MQTT status
GET {{apiUrl}}/api/mqtt/status

### Publish a simple text message to MQTT
POST {{apiUrl}}/api/mqtt/publish
Content-Type: application/json

{
  "topic": "test/message",
  "message": "Hello from BLE Gateway",
  "qos": 0
}

### Publish JSON data to MQTT
POST {{apiUrl}}/api/mqtt/publish/json
Content-Type: application/json

{
  "topic": "living_room/air_quality/data",
  "qos": 1,
  "payload": {
    "temperature": 22.5,
    "humidity": 55.0,
    "co2": 450,
    "pm1p0": 12.0,
    "pm2p5": 18.0,
    "voc_index": 125
  }
}
